{
  "version": 1,
  "intentional_exclusions": {},
  "defaults": {
    "cwd": ".",
    "env_set": {
      "FX_AUTO_UPGRADE": "0",
      "FX_SOUND": "0",
      "NO_COLOR": "1"
    },
    "env_unset": [
      "OPENROUTER_API_KEY",
      "GROQ_API_KEY",
      "AI_GATEWAY_API_KEY"
    ],
    "timeout_seconds": 1800,
    "requires_tmux": false
  },
  "scenarios": [
    {
      "name": "direct-help",
      "argv": ["{binary}", "help"],
      "cwd": ".",
      "env_set": {"FX_SKIP_ONBOARDING": "1"},
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-version",
      "argv": ["{binary}", "--version"],
      "cwd": ".",
      "env_set": {"FX_SKIP_ONBOARDING": "1"},
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-status",
      "argv": ["{binary}", "status", "--json"],
      "cwd": ".",
      "env_set": {"FX_SKIP_ONBOARDING": "1"},
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-doctor",
      "argv": ["{binary}", "doctor", "--json"],
      "cwd": ".",
      "env_set": {"FX_SKIP_ONBOARDING": "1"},
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-sessions",
      "argv": ["{binary}", "sessions", "--json"],
      "cwd": ".",
      "env_set": {"FX_SKIP_ONBOARDING": "1"},
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    }
  ],
  "verification_scenarios": []
}